<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration PUBLIC "-//ibatis.apache.org//DTD Config 3.0//EN"
        "http://ibatis.apache.org/dtd/ibatis-3-config.dtd">

<configuration>
    <settings>
        <!-- 全局映射器启用缓存 -->
        <setting name="cacheEnabled" value="true"/>
        <!-- 对于未知的SQL查询,允许返回不同的结果集以达到通用的效果 -->
        <setting name="multipleResultSetsEnabled" value="true"/>
        <!-- 允许使用列标签代替列名 -->
        <setting name="useColumnLabel" value="true"/>
        <!-- 数据库超过25000秒仍未响应则超时 -->
        <setting name="defaultStatementTimeout" value="25000"/>
        <!--所有开头为dao的类打印sql语句-->
        <!--<setting name="logPrefix" value="dao."/>-->
    </settings>

    <!-- 全局别名设置,在映射文件中只需写别名,而不必写出整个类路径 -->
    <typeAliases>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectAnnouncement" alias="projectAnnouncement"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectBoard" alias="projectBoard"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectBoardStatus" alias="projectBoardStatus"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectCollect" alias="projectCollect"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectConfigScheme" alias="projectConfigScheme"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectData" alias="projectData"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectEventField" alias="projectEventField"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectEvent" alias="projectEvent"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectEventStatus" alias="projectEventStatus"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectFieldConfig" alias="projectFieldConfig"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectFieldExtend" alias="projectFieldExtend"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectField" alias="projectField"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectFieldNumberData" alias="projectFieldNumberData"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectFieldSort" alias="projectFieldSort"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectGroupManagement" alias="projectGroupManagement"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectGroup" alias="projectGroup"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectLabel" alias="projectLabel"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.Project" alias="project"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.AdminMenu" alias="adminMenu"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.AdminRole" alias="adminRole"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.AdminRoleMenu" alias="adminRoleMenu"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectSchemeRelationBoard" alias="projectSchemeRelationBoard"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectSchemeRelation" alias="projectSchemeRelation"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectStatus" alias="projectStatus"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectTaskComment" alias="projectTaskComment"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectTaskFollows" alias="projectTaskFollows"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectTaskLog" alias="projectTaskLog"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectTask" alias="projectTask"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectTaskRelation" alias="projectTaskRelation"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectTaskTime" alias="projectTaskTime"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectTaskUser" alias="projectTaskUser"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectTaskUserSort" alias="projectTaskUserSort"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.ProjectUser" alias="projectUser"/>
        <typeAlias type="com.mbp.pmp.module.work.domain.model.wk.AdminUserRole" alias="adminUserRole"/>
    </typeAliases>

    <!-- 映射文件路径 -->
    <mappers>
        <mapper resource="sqlmap/ProjectAnnouncementMapper.xml"/>
        <mapper resource="sqlmap/ProjectBoardMapper.xml"/>
        <mapper resource="sqlmap/ProjectBoardStatusMapper.xml"/>
        <mapper resource="sqlmap/ProjectCollectMapper.xml"/>
        <mapper resource="sqlmap/ProjectConfigSchemeMapper.xml"/>
        <mapper resource="sqlmap/ProjectDataMapper.xml"/>
        <mapper resource="sqlmap/ProjectEventFieldMapper.xml"/>
        <mapper resource="sqlmap/ProjectEventMapper.xml"/>
        <mapper resource="sqlmap/ProjectEventStatusMapper.xml"/>
        <mapper resource="sqlmap/ProjectFieldConfigMapper.xml"/>
        <mapper resource="sqlmap/ProjectFieldExtendMapper.xml"/>
        <mapper resource="sqlmap/ProjectFieldMapper.xml"/>
        <mapper resource="sqlmap/ProjectFieldNumberDataMapper.xml"/>
        <mapper resource="sqlmap/ProjectFieldSortMapper.xml"/>
        <mapper resource="sqlmap/ProjectGroupManagementMapper.xml"/>
        <mapper resource="sqlmap/ProjectGroupMapper.xml"/>
        <mapper resource="sqlmap/ProjectLabelMapper.xml"/>
        <mapper resource="sqlmap/ProjectMapper.xml"/>
        <mapper resource="sqlmap/ProjectMenuMapper.xml"/>
        <mapper resource="sqlmap/ProjectRoleMapper.xml"/>
        <mapper resource="sqlmap/ProjectRoleMenuMapper.xml"/>
        <mapper resource="sqlmap/ProjectSchemeRelationBoardMapper.xml"/>
        <mapper resource="sqlmap/ProjectSchemeRelationMapper.xml"/>
        <mapper resource="sqlmap/ProjectStatusMapper.xml"/>
        <mapper resource="sqlmap/ProjectTaskCommentMapper.xml"/>
        <mapper resource="sqlmap/ProjectTaskFollowsMapper.xml"/>
        <mapper resource="sqlmap/ProjectTaskLogMapper.xml"/>
        <mapper resource="sqlmap/ProjectTaskMapper.xml"/>
        <mapper resource="sqlmap/ProjectTaskRelationMapper.xml"/>
        <mapper resource="sqlmap/ProjectTaskTimeMapper.xml"/>
        <mapper resource="sqlmap/ProjectTaskUserMapper.xml"/>
        <mapper resource="sqlmap/ProjectTaskUserSortMapper.xml"/>
        <mapper resource="sqlmap/ProjectUserMapper.xml"/>
        <mapper resource="sqlmap/ProjectUserRoleMapper.xml"/>
    </mappers>
</configuration>